---
import { SEO } from "astro-seo";
import { ClientRouter } from 'astro:transitions';
import ExitPopup from "@/components/exitpopup.astro";
import Footer from "@/components/footer.astro";
import MobileCallBar from "@/components/mobilecallbar.astro";
import Navbar from "@/components/navbar/navbar.astro";
import OrganizationSchema from "@/components/organizationschema.astro";
import { business } from "@/config/business";
import "@fontsource-variable/inter/index.css";
import "@fontsource-variable/outfit/index.css";
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const resolvedImageWithDomain = new URL("/opengraph.jpg", Astro.site).toString();
const { title, description } = Astro.props;

const makeTitle = title
  ? `${title} | ${business.name}`
  : `${business.name} — ${business.niche} in ${business.city}, ${business.state}`;

const makeDescription =
  description ??
  `${business.name} provides professional ${business.niche} services in ${business.city}, ${business.state} and surrounding areas. ${business.guaranteeText}. Call ${business.phone} for a free quote.`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO
      title={makeTitle}
      description={makeDescription}
      canonical={canonicalURL}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: makeTitle,
          image: resolvedImageWithDomain,
        },
        image: { alt: makeTitle },
      }}
    />
    <slot name="head" />
    <OrganizationSchema />
    <ClientRouter />
    <!-- Reloading a page starts at the top (browsers otherwise restore the old scroll spot), unless the link has a #section. -->
    <script is:inline>
      if ("scrollRestoration" in history) history.scrollRestoration = "manual";
      document.addEventListener("DOMContentLoaded", function () { if (!location.hash) window.scrollTo(0, 0); });
    </script>
    <!-- PostHog analytics: set PUBLIC_POSTHOG_KEY (and PUBLIC_POSTHOG_HOST for the EU cloud) in your environment variables.
         Tracks page views, "phone_clicked" (someone tapped a phone link, which shows intent, not a completed call)
         and "quote_submitted" (a quote form was sent successfully). Omitted entirely when the key isn't set. -->
    {import.meta.env.PUBLIC_POSTHOG_KEY && (
      <script is:inline define:vars={{ phKey: import.meta.env.PUBLIC_POSTHOG_KEY, phHost: import.meta.env.PUBLIC_POSTHOG_HOST || "https://us.i.posthog.com" }}>
        !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once unregister identify alias reset opt_in_capturing opt_out_capturing has_opted_out_capturing get_distinct_id get_property".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
        posthog.init(phKey, { api_host: phHost, person_profiles: "identified_only" });
        if (!window.__phoneTracking) {
          window.__phoneTracking = true;
          document.addEventListener("click", function (e) {
            var a = e.target.closest && e.target.closest('a[href^="tel:"]');
            if (a) posthog.capture("phone_clicked", { page: location.pathname, link_text: (a.textContent || "").trim().slice(0, 60) });
          });
        }
      </script>
    )}
    <!-- Cloudflare Web Analytics — set CF_ANALYTICS_TOKEN in your environment variables -->
    {import.meta.env.CF_ANALYTICS_TOKEN && (
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${import.meta.env.CF_ANALYTICS_TOKEN}"}`}></script>
    )}
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <MobileCallBar />
    <ExitPopup />

    <script is:inline>
      (function () {
        // Sticky nav shadow
        const nav = document.getElementById("site-nav");
        if (nav) {
          window.addEventListener("scroll", () => {
            nav.classList.toggle("scrolled", window.scrollY > 10);
          }, { passive: true });
        }

        // Animated counters
        const counters = document.querySelectorAll("[data-counter]");
        const counterObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target;
              const target = parseInt(el.getAttribute("data-counter"), 10);
              const suffix = el.getAttribute("data-suffix") || "";
              const duration = 1800;
              const steps = 60;
              const increment = target / steps;
              let current = 0;
              const timer = setInterval(() => {
                current = Math.min(current + increment, target);
                el.textContent = Math.floor(current).toLocaleString() + suffix;
                if (current >= target) clearInterval(timer);
              }, duration / steps);
              counterObserver.unobserve(el);
            });
          },
          { threshold: 0.5 }
        );
        counters.forEach((el) => counterObserver.observe(el));
      })();
    </script>

    <script>
      // Scroll animations with Motion (motion.dev). Anything marked data-aos="fade-up|fade-left|fade-right"
      // (optional data-aos-delay in ms) fades in as it scrolls into view, and Lucide icons pop in with a spring.
      // Content already on screen at load is never hidden, so the first paint stays fast.
      import { animate, inView } from "motion";

      const OFFSETS: Record<string, [number, number]> = { "fade-up": [0, 28], "fade-down": [0, -28], "fade-left": [28, 0], "fade-right": [-28, 0] };
      const EASE: [number, number, number, number] = [0.22, 1, 0.36, 1];

      function initMotion() {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const below = (el: Element) => el.getBoundingClientRect().top > innerHeight * 0.95;

        document.querySelectorAll<HTMLElement>("[data-aos]").forEach((el) => {
          if (el.dataset.motion || !below(el)) return;
          el.dataset.motion = "1";
          const [x, y] = OFFSETS[el.dataset.aos ?? ""] ?? [0, 28];
          el.style.opacity = "0";
          el.style.transform = `translate(${x}px, ${y}px)`;
          inView(el, () => {
            animate(el, { opacity: 1, transform: "translate(0px, 0px)" }, { duration: 0.65, delay: Number(el.dataset.aosDelay || 0) / 1000, ease: EASE })
              .then(() => { el.style.transform = ""; });
          }, { margin: "0px 0px -10% 0px" });
        });

        document.querySelectorAll<SVGElement>("main svg[data-icon]").forEach((icon) => {
          if (icon.dataset.motion || !below(icon)) return;
          icon.dataset.motion = "1";
          icon.style.opacity = "0";
          icon.style.transform = "scale(0.4) rotate(-20deg)";
          inView(icon, () => {
            animate(icon, { opacity: 1, transform: "scale(1) rotate(0deg)" }, { type: "spring", stiffness: 260, damping: 14, delay: 0.15 })
              .then(() => { icon.style.transform = ""; });
          }, { margin: "0px 0px -5% 0px" });
        });
      }

      document.addEventListener("astro:page-load", initMotion);
      initMotion();
    </script>
  </body>
</html>
